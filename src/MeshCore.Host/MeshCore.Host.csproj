<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MeshCore.Host</RootNamespace>
    <AssemblyName>MeshCore.Host</AssemblyName>
    <Description>MeshCore Computer Client: radio connection, REST API and website.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- App code: no ConfigureAwait needed (no sync context in ASP.NET Core). -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeshCore.Client\MeshCore.Client.csproj" />
    <ProjectReference Include="..\MeshCore.Data\MeshCore.Data.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <InternalsVisibleTo Include="MeshCore.Host.Tests" />
    <Content Update="libman.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
