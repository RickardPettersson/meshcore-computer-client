{
  "MeshCore": {
    "Connection": "192.168.1.212:5000",
    "AppName": "MeshCoreComputerClient",
    "DataDirectory": "data",
    "TakeoverBackoff": "00:02:00",
    "PollInterval": "00:01:00"
  },
  "Kestrel": {
    "Endpoints": {
      "Web": { "Url": "http://0.0.0.0:5080" },
      "Api": { "Url": "http://127.0.0.1:5081" }
    }
  },
  "Web": {
    "SeparatePorts": true,
    "RequireHttps": false
  },
  "Auth": {
    "TokenLifetime": "08:00:00",
    "LockoutAttempts": 5,
    "LockoutDuration": "00:15:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MeshCore.Client.Transport": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "SingleLine": true, "TimestampFormat": "HH:mm:ss " }
    }
  },
  "AllowedHosts": "*"
}
