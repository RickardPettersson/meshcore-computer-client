@model UserResponse
@{
    ViewData["Title"] = "Settings";
    var isAdmin = Model.Role == UserRole.Admin;
}
<partial name="_PageHeader" model="@(("Settings", (string?)null))" />

<div class="row g-3">
    <div class="col-lg-6">
        <div class="list-group">
            <div class="list-group-item d-flex align-items-center gap-3 py-3">
                <i class="bi bi-person-circle fs-3" aria-hidden="true"></i>
                <div class="me-auto">
                    <div class="fw-semibold">@Model.Username</div>
                    <div class="small text-body-secondary">@Model.Role · last sign-in <partial name="_Time" model="Model.LastLoginUtc" /></div>
                </div>
            </div>
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" asp-controller="Account" asp-action="ChangePassword">
                <i class="bi bi-key fs-5" aria-hidden="true"></i><span class="me-auto">Change password</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" asp-controller="Device" asp-action="Index">
                <i class="bi bi-cpu fs-5" aria-hidden="true"></i><span class="me-auto">Device</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" asp-controller="Battery" asp-action="Index">
                <i class="bi bi-battery-half fs-5" aria-hidden="true"></i><span class="me-auto">My devices</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            @if (isAdmin)
            {
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" asp-action="Users">
                    <i class="bi bi-person-gear fs-5" aria-hidden="true"></i><span class="me-auto">Users</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            }
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" asp-controller="Account" asp-action="Certificate">
                <i class="bi bi-shield-lock fs-5" aria-hidden="true"></i><span class="me-auto">Secure connection (HTTPS) on phones</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" data-theme-toggle>
                <i class="bi bi-circle-half fs-5" aria-hidden="true"></i><span class="me-auto">Switch light / dark</span>
            </button>
            <form asp-controller="Account" asp-action="Logout" method="post" class="list-group-item p-0">
                <button type="submit" class="btn w-100 text-start d-flex align-items-center gap-3 py-3 px-3 text-danger">
                    <i class="bi bi-box-arrow-right fs-5" aria-hidden="true"></i><span>Sign out</span>
                </button>
            </form>
        </div>
    </div>
</div>
