@model ChannelsPageViewModel
@{
    ViewData["Title"] = "Channels";
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
}
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="me-auto">
        <h1 class="h3 mb-0">Channels</h1>
        <p class="text-body-secondary small mb-0">@Model.Channels.Count of @(Model.MaxChannels?.ToString() ?? "?") slots in use</p>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn-sm btn-primary" asp-action="Edit"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add channel</a>
    }
</div>

@if (Model.Revealed is { } secret)
{
    <div class="alert alert-info" role="status">
        <div class="fw-semibold mb-1"><i class="bi bi-key" aria-hidden="true"></i> Key for '@secret.Name'</div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <code class="app-mono user-select-all">@secret.SecretHex</code>
            <button type="button" class="btn btn-sm btn-outline-primary" data-copy="@secret.SecretHex"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy</button>
        </div>
        <div class="small mt-2">Anyone with this key can read and post in the channel. Share it only with people who should.</div>
    </div>
}

@if (Model.Channels.Count == 0)
{
    <div class="card"><div class="card-body text-body-secondary">No channels are configured on the radio.</div></div>
}
else
{
    <div class="list-group">
        @foreach (var c in Model.Channels)
        {
            <div class="list-group-item d-flex flex-wrap align-items-center gap-2 py-3">
                <span class="app-avatar flex-shrink-0 rounded-circle bg-primary-subtle text-primary-emphasis" aria-hidden="true"><i class="bi bi-hash"></i></span>
                <a class="me-auto text-decoration-none" asp-controller="Messages" asp-action="Channel" asp-route-id="@c.Index">
                    <strong>@c.Name</strong> <span class="text-body-secondary small">slot @c.Index</span>
                </a>
                <a class="btn btn-sm btn-primary" asp-controller="Messages" asp-action="Channel" asp-route-id="@c.Index"><i class="bi bi-chat" aria-hidden="true"></i><span class="d-none d-sm-inline"> Open</span></a>
                @if (isAdmin)
                {
                    <form asp-action="Reveal" method="post">
                        <input type="hidden" name="index" value="@c.Index">
                        <button class="btn btn-sm btn-outline-secondary" type="submit" title="Show key" aria-label="Show key for @c.Name"><i class="bi bi-key" aria-hidden="true"></i></button>
                    </form>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-index="@c.Index" title="Edit" aria-label="Edit @c.Name"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    <form asp-action="Delete" method="post" data-confirm="Delete channel '@c.Name' from the radio? You'll need its key to join again." data-confirm-button="Delete">
                        <input type="hidden" name="index" value="@c.Index">
                        <input type="hidden" name="name" value="@c.Name">
                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete" aria-label="Delete @c.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                    </form>
                }
            </div>
        }
    </div>
}
