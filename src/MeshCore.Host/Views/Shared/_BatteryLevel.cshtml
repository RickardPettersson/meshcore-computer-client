@model BatteryResponse
@* Battery as "82% (4.050 V)" with a small level bar. The percentage is estimated from the voltage. *@
@if (Model.Percent is { } pct)
{
    var icon = pct switch
    {
        >= 70 => "bi-battery-full",
        >= 15 => "bi-battery-half",
        _ => "bi-battery",
    };
    <span title="Estimated from the voltage (single-cell Li-ion). It reads high while charging and dips while transmitting.">
        <i class="bi @icon" aria-hidden="true"></i>
        <a class="fw-semibold" asp-controller="Battery" asp-action="History" asp-route-node="self" title="Battery history">@pct%</a>
        <span class="text-body-secondary">(@Model.Volts.ToString("0.000") V)</span>
    </span>
    @* <meter> colours itself: red below "low", yellow below "high", green above. No inline styles (CSP). *@
    <meter class="app-battery-meter d-block mt-1" min="0" max="100" low="20" high="40" optimum="100" value="@pct" aria-label="Battery level @pct%">@pct%</meter>
}
else
{
    <span>@Model.Volts.ToString("0.000") V</span>
}
