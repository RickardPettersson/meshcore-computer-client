@model BatteryResponse
@* Battery as "82% (4.050 V)" with a small level bar. The percentage is estimated from the voltage.
   ViewData["BatteryHistoryNode"]: the node whose battery history the % links to ("self" by default; "" for no link). *@
@{ var historyNode = ViewData["BatteryHistoryNode"] as string ?? "self"; }
@if (Model.Percent is { } pct)
{
    var icon = pct switch
    {
        >= 70 => "bi-battery-full",
        >= 15 => "bi-battery-half",
        _ => "bi-battery",
    };
    <span title="Estimated from the voltage: 3.0 V is 0%, 4.2 V is 100%, as in the MeshCore app. It reads high while charging and dips while transmitting.">
        <i class="bi @icon" aria-hidden="true"></i>
        @if (historyNode.Length > 0)
        {
            <a class="fw-semibold" asp-controller="Battery" asp-action="History" asp-route-node="@historyNode" title="Battery history">@pct%</a>
        }
        else
        {
            <span class="fw-semibold">@pct%</span>
        }
        <span class="text-body-secondary">(@Model.Volts.ToString("0.000") V)</span>
    </span>
    @* <meter> colours itself: red below "low", yellow below "high", green above. No inline styles (CSP). *@
    <meter class="app-battery-meter d-block mt-1" min="0" max="100" low="20" high="40" optimum="100" value="@pct" aria-label="Battery level @pct%">@pct%</meter>
}
else
{
    <span>@Model.Volts.ToString("0.000") V</span>
}
