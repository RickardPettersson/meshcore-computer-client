@model ConversationResponse
@{
    var m = Model.LastMessage;
    var isChannel = Model.Kind == MessageKind.Channel;
    var preview = m is null ? null
        : m.Direction == MessageDirection.Outgoing ? $"You: {m.Text}"
        : isChannel && m.SenderName is { } n ? $"{n}: {m.Text}"
        : m.Text;
}
<a class="list-group-item list-group-item-action d-flex gap-3 py-3"
   asp-controller="Messages" asp-action="@(isChannel ? "Channel" : "Direct")" asp-route-id="@(isChannel ? Model.ChannelIndex.ToString() : Model.ContactKeyPrefix)">
    <span class="app-avatar flex-shrink-0 rounded-circle bg-primary-subtle text-primary-emphasis" aria-hidden="true">
        <i class="bi @(isChannel ? "bi-hash" : "bi-person")"></i>
    </span>
    <span class="flex-grow-1 min-w-0">
        <span class="d-flex gap-2">
            <strong class="text-truncate me-auto">@Model.Title</strong>
            @if (m is not null)
            {
                <small class="text-body-secondary text-nowrap"><partial name="_Time" model="@((DateTimeOffset?)m.ReceivedAt)" /></small>
            }
        </span>
        <span class="d-block text-body-secondary text-truncate small">
            @if (preview is null)
            {
                <em>No messages yet</em>
            }
            else
            {
                @preview
            }
        </span>
    </span>
</a>
