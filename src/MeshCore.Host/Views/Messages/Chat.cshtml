@model ChatViewModel
@{
    ViewData["Title"] = Model.Title;
    var me = User.FindFirst(MeshClaims.UserId)?.Value;
    var isChannel = Model.ChannelIndex is not null;
}
@functions {
    public static string StatusIcon(DeliveryStatus s) => s switch
    {
        DeliveryStatus.Sending => "bi-clock",
        DeliveryStatus.Sent => "bi-check2",
        DeliveryStatus.Delivered => "bi-check2-all",
        DeliveryStatus.NotConfirmed => "bi-question-circle",
        DeliveryStatus.Failed => "bi-exclamation-circle",
        _ => "",
    };
}
<div class="d-flex align-items-center gap-2 mb-3">
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index" aria-label="Back to chats"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
    <span class="app-avatar flex-shrink-0 rounded-circle bg-primary-subtle text-primary-emphasis" aria-hidden="true"><i class="bi @(isChannel ? "bi-hash" : "bi-person")"></i></span>
    <div class="min-w-0 me-auto">
        <h1 class="h5 mb-0 text-truncate">@Model.Title</h1>
        <div class="small text-body-secondary">@Model.Subtitle</div>
    </div>
    <span class="small text-body-secondary d-none" data-live-state title="Live updates"><i class="bi bi-lightning-charge" aria-hidden="true"></i> live</span>
</div>

@* Everything chat.js needs, as data attributes (the CSP allows no inline script). *@
<div class="app-chat" id="chat" aria-live="polite"
     data-conversation="@Model.Key" data-me="@me" data-channel="@(isChannel ? "true" : "false")"
     data-updates-url="@Url.Action("Updates", "Messages")" data-read-url="@Url.Action("MarkRead", "Messages")"
     data-direct-url="@Url.Action("Direct", "Messages", new { id = "__key__" })" data-sender-url="@Url.Action("Sender", "Messages", new { channel = Model.ChannelIndex })"
     data-sender-contacts="@(isChannel ? System.Text.Json.JsonSerializer.Serialize(Model.SenderContacts ?? new Dictionary<string, string>()) : "")">
    @if (Model.Messages.Count == 50)
    {
        <a class="btn btn-sm btn-link align-self-center" asp-action="@(isChannel ? "Channel" : "Direct")"
           asp-route-id="@(Model.ContactKey ?? Model.ChannelIndex.ToString())" asp-route-before="@Model.Messages[0].Id">Older messages</a>
    }
    <p class="text-center text-body-secondary my-5 @(Model.Messages.Count == 0 ? "" : "d-none")" data-empty>No messages here yet. Say hello!</p>
    @foreach (var m in Model.Messages)
    {
        var mine = m.Direction == MessageDirection.Outgoing;
        <div class="app-bubble @(mine ? "mine" : "theirs") @(m.TextType == MeshCore.Protocol.TextType.CliData ? "font-monospace small" : "")" data-id="@m.Id">
            @if (!mine && isChannel && m.SenderName is { } who)
            {
                <div class="fw-semibold small" data-sender>
                    @if (Model.SenderKey(who) is { } senderKey)
                    {
                        <a class="app-sender" asp-action="Direct" asp-route-id="@senderKey" title="Send @who a private message">@who<i class="bi bi-chat-dots ms-1" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <a class="app-sender unknown" asp-action="Sender" asp-route-name="@who" asp-route-channel="@Model.ChannelIndex"
                           title="@who isn't in your contacts yet. Tap to see how to message them privately.">@who</a>
                    }
                </div>
            }
            <div data-text>@m.Text</div>
            <div class="meta d-flex gap-2 justify-content-end">
                @if (mine && m.SentByUserId is { } uid && uid != me)
                {
                    <span>by @(Model.UserNames.TryGetValue(uid, out var n) ? n : "another user")</span>
                }
                @if (!mine)
                {
                    <span>@(m.Hops is { } h ? $"{h} hop(s)" : "direct")@(m.Snr is { } s ? $" · {s:0.0} dB" : "")</span>
                }
                <partial name="_Time" model="@((DateTimeOffset?)m.ReceivedAt)" />
                @if (mine)
                {
                    <i class="bi @StatusIcon(m.Status)" data-status="@m.Status"
                       title="@m.Status@(m.RoundTripMs is { } rt ? $" ({rt} ms)" : "")@(m.Error is { } e ? $": {e}" : "")" aria-label="@m.Status"></i>
                }
            </div>
        </div>
    }
    <div id="chat-end"></div>
</div>

@* Cloned by chat.js for messages that arrive live. Same structure as above. *@
<template id="bubble-template">
    <div class="app-bubble" data-id="">
        <div class="fw-semibold small d-none" data-sender></div>
        <div data-text></div>
        <div class="meta d-flex gap-2 justify-content-end">
            <span class="d-none" data-by></span>
            <span class="d-none" data-signal></span>
            <time data-local-time></time>
            <i class="bi d-none" data-status></i>
        </div>
    </div>
</template>

@{ var images = Model.Images is { Enabled: true } ? Model.Images : null; }
<form class="app-composer border-top" asp-action="Send" method="post" id="composer"
      data-upload-url="@(images is null ? "" : Url.Action("UploadImage", "Messages"))" data-max-upload="@(images?.MaxUploadBytes ?? 0)">
    @if (Model.ContactKey is { } key)
    {
        <input type="hidden" name="contact" value="@key">
    }
    else
    {
        <input type="hidden" name="channel" value="@Model.ChannelIndex">
    }
    <div class="alert alert-danger py-2 small d-none mb-2" role="alert" data-send-error></div>
    <div class="d-flex gap-2 align-items-end">
        @if (images is not null)
        {
            @* Shown by chat.js (needs JavaScript). *@
            <button type="button" class="btn btn-outline-secondary d-none" data-image-button aria-label="Share a photo" title="Share a photo (upload and insert its link)">
                <i class="bi bi-image" aria-hidden="true"></i>
            </button>
            <input type="file" class="d-none" accept="image/*" data-image-input aria-hidden="true" tabindex="-1">
        }
        <label for="text" class="visually-hidden">Message</label>
        <textarea id="text" name="text" class="form-control" rows="1" required placeholder="Message @Model.Title"
                  data-byte-limit="@Model.MaxBytes" data-counter="byte-count" autocomplete="off">@Model.Draft</textarea>
        <button type="submit" class="btn btn-primary" aria-label="Send"><i class="bi bi-send" aria-hidden="true"></i></button>
    </div>
    <div class="d-flex flex-wrap gap-2 small text-body-secondary mt-1">
        @if (Model.CliAvailable)
        {
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="cli" name="cli" value="true">
                <label class="form-check-label" for="cli">CLI command <span class="d-none d-sm-inline">(needs an admin login on the Contacts page)</span></label>
            </div>
        }
        <span class="me-auto" data-composer-hint>@(isChannel ? "Channel messages aren't confirmed." : Model.CliAvailable ? "" : "Delivery is confirmed by the recipient: ✓ sent, ✓✓ delivered.")</span>
        @if (images is not null)
        {
            <span class="d-none align-items-center gap-1" data-image-options>
                <label for="image-expiry"><i class="bi bi-image" aria-hidden="true"></i> photos kept</label>
                <select id="image-expiry" class="form-select form-select-sm py-0 w-auto" data-image-expiry data-default="@images.DefaultExpiry"
                        title="How long a shared photo stays online. Anyone with the link can open it; it isn't listed anywhere.">
                    @foreach (var e in MeshCore.Host.Images.ImageExpiries.All)
                    {
                        <option value="@e.Value" selected="@(e.Value == images.DefaultExpiry)">@e.Label</option>
                    }
                </select>
            </span>
        }
        <span id="byte-count">0 / @Model.MaxBytes</span>
    </div>
</form>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
