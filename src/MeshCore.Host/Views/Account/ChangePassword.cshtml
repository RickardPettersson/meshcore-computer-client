@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<div class="@(Model.Forced ? "app-auth" : "app-narrow")">
    @if (Model.Forced)
    {
        <div class="text-center mb-4">
            <i class="bi bi-shield-lock display-5 text-primary" aria-hidden="true"></i>
            <h1 class="h3 mt-3">Choose your password</h1>
            <p class="text-body-secondary">You signed in with a temporary password. Pick your own to continue.</p>
        </div>
    }
    else
    {
        <partial name="_PageHeader" model="@(("Change password", (string?)null))" />
    }
    <div class="card shadow-sm"><div class="card-body p-4">
        <form asp-action="ChangePassword" method="post" novalidate>
            <input type="hidden" asp-for="Forced">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">@(Model.Forced ? "Temporary password" : "Current password")</label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus>
                <span asp-validation-for="CurrentPassword" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password">
                <div class="form-text">At least @CredentialRules.MinPasswordLength characters, and not containing your username.</div>
                <span asp-validation-for="NewPassword" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password">
                <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">Change password</button>
        </form>
        @if (Model.Forced)
        {
            <form asp-action="Logout" method="post" class="text-center mt-3"><button type="submit" class="btn btn-link btn-sm">Sign out instead</button></form>
        }
    </div></div>
</div>
