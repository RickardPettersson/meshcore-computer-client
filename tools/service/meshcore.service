# systemd unit for Linux (e.g. a Raspberry Pi). From the unpacked release folder, install or update with:
#   sudo ./service/install-linux-service.sh
# which copies the app to /opt/meshcore, creates the "meshcore" user (in group dialout, for USB radios) and enables this unit.
[Unit]
Description=MeshCore Computer Client
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=meshcore
WorkingDirectory=/opt/meshcore
ExecStart=/opt/meshcore/MeshCore.Host
Restart=on-failure
RestartSec=10
Environment=DOTNET_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target
